  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                fusionauth_user_id,\n                email_address,\n                refresh_token_ciphertext,\n                encrypted_data_key,\n                nonce,\n                encryption_version,\n                kms_key_id,\n                created_at,\n                updated_at,\n                last_refreshed_at,\n                microsoft_tenant_id,\n                microsoft_object_id\n            FROM microsoft_oauth_grants\n            WHERE fusionauth_user_id = $1\n              AND email_address = $2\n              AND grant_purpose = 'mailbox_read'\n              AND grant_schema_version = 1\n              AND disconnected_at IS NULL\n        ",
